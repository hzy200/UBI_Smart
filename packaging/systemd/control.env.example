# /etc/coding-agent/control.env
# 权限：chmod 640, owner root, group coding-agent
AGENT_INTERNAL_URL=http://127.0.0.1:8790
AGENT_INTERNAL_TOKEN=replace-with-a-long-random-token
AGENT_CONTROL_DB_URL='mysql+pymysql://coding_agent:change-me@127.0.0.1:3306/coding_agent?charset=utf8mb4'
# 生产由 ExecStartPre 的 --migrate-only 负责迁移，不依赖 create_all。
AGENT_CONTROL_DB_AUTO_CREATE=false
AGENT_CONTROL_BACKUP_DIR=/var/lib/coding-agent/backups
# 公网/多用户必须配置 Web 认证；安装脚本会生成随机 token。
# AGENT_WEB_AUTH_TOKENS='{"replace-with-token":"admin"}'
# 服务器密钥优先用 systemd Credentials / KMS，不用 keyring。
# AGENT_SECRET_PROVIDER=systemd
# AGENT_EVENT_TRANSPORT=redis
# AGENT_EVENT_TRANSPORT_URL=redis://127.0.0.1:6379/0
