# /etc/coding-agent/agent.env
# 权限：chmod 640, owner root, group coding-agent
AGENT_INTERNAL_TOKEN=replace-with-a-long-random-token
AGENT_AGENT_DATA_ROOT=/var/lib/coding-agent/agent
AGENT_AUDIT_DIR=/var/lib/coding-agent/audit
AGENT_SNAPSHOT_MANIFEST_DIR=/var/lib/coding-agent/snapshot-manifests
AGENT_CHECKPOINT_PATH=/var/lib/coding-agent/checkpoints.sqlite
AGENT_STEERING_DIR=/var/lib/coding-agent/steering
AGENT_EXECUTION_BACKEND=local
# 多实例 SSE 重放时启用
# AGENT_EVENT_TRANSPORT=redis
# AGENT_EVENT_TRANSPORT_URL=redis://127.0.0.1:6379/0
