# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。

# ---------- DeepSeek ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 建议保持 deepseek-chat：deepseek-v4-flash 的思考模式偶发 reasoning_content 400
# （langchain-openai 不提取该字段，详见 docs/USAGE.md 的故障排查）
DEEPSEEK_MODEL=deepseek-chat
# 多 provider JSON（空 = 只用上面的 DEEPSEEK_*）：
# [{"name":"deepseek","base_url":"https://api.deepseek.com","api_key_env":"DEEPSEEK_API_KEY","model":"deepseek-chat","priority":0,
#   "input_cost_per_1m":0.14,"output_cost_per_1m":0.28,"max_tokens":1000000,"max_cost":5.0,
#   "capabilities":["chat","tools"],"task_types":["agent","worker"],
#   "billing":{"kind":"openai_costs","base_url":"https://api.openai.com/v1","api_key_env":"OPENAI_ADMIN_KEY"}},
#  {"name":"backup","base_url":"https://api.example.com/v1","api_key_env":"BACKUP_API_KEY","model":"backup-model","priority":1,
#   "input_cost_per_1m":0.5,"output_cost_per_1m":1.0,"capabilities":["chat","tools"],
#   "task_types":["worker"]}]
AGENT_LLM_PROVIDERS=
# 非 429 错误是否也切换下一个 provider
AGENT_LLM_FALLBACK_ON_ERROR=true
# 所有 provider 冷却时，单次调用最多等待秒数
AGENT_LLM_PROVIDER_MAX_WAIT_S=30
# 节点级瞬时错误重试（超时/连接重置/5xx/429/环境抖动）。
# attempts 是总尝试次数，1 = 不重试；退避为指数 + 抖动，总等待有上限。
AGENT_RETRY_ATTEMPTS=3
AGENT_RETRY_BASE_DELAY_S=1.0
AGENT_RETRY_MAX_DELAY_S=30
AGENT_RETRY_MAX_TOTAL_WAIT_S=60
# cost（按单价/配额路由）| priority（按配置顺序）
AGENT_LLM_ROUTING_STRATEGY=cost
# 单次 run 成本预算（USD，0 = 不告警）与告警比例
AGENT_RUN_COST_BUDGET_USD=0
AGENT_COST_ALERT_RATIO=0.8
# 整个会话（同一 thread 多轮累计）成本预算（USD，0 = 不限制）。
# 全新 run 开始前硬拦截；resume 不拦截，避免挂起的审批被锁死。
AGENT_SESSION_COST_BUDGET_USD=0
# run 结束时拉取 provider 账单 API 对账
AGENT_BILLING_ENABLED=false
AGENT_BILLING_TIMEOUT_S=10

# ---------- LangSmith 追踪 ----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=coding-agent

# ---------- WSL2 沙箱 ----------
AGENT_WSL_DISTRO=Ubuntu
# 留空则自动使用沙箱内 $HOME/agent-ws（agent sandbox-init 会创建并打印实际路径）
# 也接受 Windows 路径写法，如 D:\proj
AGENT_WSL_WORKSPACE=
# 执行后端：auto（Windows 用 wsl.exe，WSL/Linux 内直接本地执行）| local | wsl
AGENT_EXECUTION_BACKEND=auto
# shell 隔离后端：off（默认，仅工作区 cwd 约束）| bwrap（挂载命名空间隔离）
# bwrap 需在沙箱内 `sudo apt install bubblewrap`；配了却不可用时会拒绝执行
AGENT_SHELL_SANDBOX=off
# 仅 bwrap 模式生效：false 时命令完全无网络（--unshare-net）
AGENT_SHELL_NETWORK=true
# WSL 命令默认 env -i 清空宿主环境。这里显式放行构建变量（逗号分隔名称，
# 如 JAVA_HOME,GOPATH,VIRTUAL_ENV）；KEY/TOKEN/SECRET/PASSWORD 等名称始终忽略。
AGENT_SHELL_ENV_ALLOWLIST=
# 常驻 WSL bash 会话池（默认开启；失败自动退回逐命令 wsl.exe）
AGENT_PERSISTENT_SHELL=true
AGENT_PERSISTENT_SHELL_POOL=4
AGENT_SHELL_TIMEOUT=60
# WSL 健康检查与熔断：连续失败 N 次后短时间 fail fast，冷却后放一个探测请求。
AGENT_WSL_HEALTH_CHECK=true
AGENT_WSL_HEALTH_TTL_S=30
AGENT_WSL_HEALTH_TIMEOUT_S=10
AGENT_WSL_BREAKER_FAILURES=3
AGENT_WSL_BREAKER_COOLDOWN_S=15
AGENT_WSL_BREAKER_MAX_COOLDOWN_S=60

# ---------- 统一并发治理 ----------
# 0 = 回退到旧的单项配置（ORCHESTRATOR_MAX_CONCURRENT_WORKERS 等）。
AGENT_CONCURRENCY_WORKERS=0
AGENT_CONCURRENCY_TOOLS=0
AGENT_CONCURRENCY_WSL=0
# 给健康探针保留的 WSL 槽位（普通命令不能用）。
AGENT_CONCURRENCY_WSL_RESERVE=1
# 基于命令 p95 延迟的弹性并发（只在池子饱和时调整）。
AGENT_CONCURRENCY_WSL_ADAPTIVE=true
AGENT_CONCURRENCY_WSL_MIN=2
# 0 = 以初始并发为上限（只降不升超过初始值）。
AGENT_CONCURRENCY_WSL_MAX=0
AGENT_CONCURRENCY_WSL_TARGET_MS=1500
AGENT_CONCURRENCY_WSL_LATENCY_WINDOW=20
AGENT_CONCURRENCY_LLM_PER_PROVIDER=4
AGENT_CONCURRENCY_LLM_GLOBAL=6
AGENT_CONCURRENCY_WORKER_TIMEOUT_S=60
AGENT_CONCURRENCY_LLM_TIMEOUT_S=30
AGENT_CONCURRENCY_WSL_TIMEOUT_S=30
# LLM 每 provider 的 AIMD 并发范围
AGENT_LLM_AIMD_MIN=1
AGENT_LLM_AIMD_MAX=8
# 自动验证的独立超时（测试/构建通常比普通命令长）；0 = 回退到 shell_timeout。
AGENT_VERIFY_TIMEOUT=300
AGENT_MAX_OUTPUT_CHARS=20000
# 捕获阶段单条命令 stdout/stderr 各自的字节上限（0 = 不限制）
AGENT_MAX_CAPTURE_BYTES=1000000
# 追加的内容级写保护 glob（逗号分隔）；.env / 密钥 / .git 等默认规则始终生效
AGENT_WRITE_DENY_GLOBS=
# 注入 planner 的 AST repo map 字符预算（0 = 关闭）
AGENT_REPO_MAP_CHARS=4000
# 可选 language server（空 = symbol_search 只用 AST；配置后 code_intel 可用）
# 例：AGENT_LSP_COMMAND=pylsp
#     AGENT_LSP_COMMAND=wsl.exe -d Ubuntu -- pylsp
AGENT_LSP_COMMAND=
AGENT_LSP_TIMEOUT=10
# pull 诊断不可用时等待 publishDiagnostics 的长秒数
AGENT_LSP_DIAGNOSTICS_WAIT_S=2
# 持久放行规则，逗号分隔的 tool:glob；只覆盖原本会 ASK 的 L2
# 例：AGENT_ALLOW_RULES=shell_exec:git status*,run_tests:*
AGENT_ALLOW_RULES=

# ---------- 沙箱资源上限（0 表示不限制）----------
AGENT_SHELL_CPU_SECONDS=600
# 内存默认不限制：JVM / Node / 编译器会索取远超实际使用的虚拟地址空间
AGENT_SHELL_MEMORY_MB=0
AGENT_SHELL_MAX_FILE_MB=512
AGENT_SHELL_MAX_PROCESSES=1024
# 并发 worker 同时启动的 wsl.exe 上限；防止工具轮次把 WSL 压满
AGENT_SANDBOX_MAX_CONCURRENT_COMMANDS=8

# ---------- 上下文裁剪（0 表示不裁剪）----------
AGENT_CONTEXT_MAX_CHARS=60000
# 估算 token 上限；与字符上限同时生效，任一超出都会触发降档。
# 0 = 只按字符预算。
AGENT_CONTEXT_MAX_TOKENS=0
AGENT_CONTEXT_KEEP_RECENT=12
AGENT_CONTEXT_TOOL_CHARS=1500
# 每次运行注入 system prompt 的长期记忆条数（按与请求的相关度取前 K 条）。
# 0 = 不限制；模型仍可通过 memory_search 工具按需检索。
AGENT_MEMORY_TOP_K=8
# run 级文件内容缓存（LRU）字节上限；0 = 关闭。
AGENT_READ_CACHE_MAX_BYTES=67108864
# AST 符号索引 / 包管理器探测的缓存时间（秒）。
AGENT_SYMBOL_INDEX_TTL_S=10
AGENT_DEPS_DETECT_TTL_S=30
# 是否发现并注入仓库内的 AGENTS.md / CLAUDE.md（分层项目指令）
AGENT_INSTRUCTIONS_ENABLED=true
# 编排子图/worker 的会话约束摘要上限（字符）。独立子图不复制 messages，
# 这里从 checkpoint 抽最近若干轮压缩后注入；0 = 关闭。
AGENT_SESSION_BRIEF_CHARS=4000

# ---------- 验证 ----------
AGENT_VERIFY_ENABLED=true
# 多步任务只在 kind=verify 或最后一步跑全量测试；早期实现步不跑（避免被
# 后面还没做的步骤卡死）。单步任务不受影响。
AGENT_VERIFY_ONLY_FINAL=true
# 留空则按项目清单自动识别（Cargo.toml / go.mod / package.json / pytest / Makefile）
AGENT_VERIFY_COMMAND=

# ---------- 代码审查 ----------
# 验证通过后对本次改动做一遍确定性静态检查（语法、被改弱的测试、调试残留、
# 是否写进 .agent/）。阻断项走与验证失败同一条修复回路；关掉它等于去掉
# 「测试通过 ≠ 代码正确」的第二道关。
AGENT_REVIEW_ENABLED=true
# 探测到的 linter/formatter（ruff/mypy/gofmt）对**本次改动文件**的发现是否阻断。
# 只提升改动文件；仓库历史问题不会每一步都卡死。
AGENT_REVIEW_LINT_BLOCKING=true

# ---------- 子智能体（Phase 1：只读 Explore）----------
# 默认关闭：打开后主模型会多一个 delegate_explore 工具，行为改变、旧评测基线
# 不再可比。评测时显式设为 true 做 A/B。
AGENT_EXPLORE_ENABLED=false
# 子智能体最多几轮「模型 → 工具」；到顶后强制生成报告（状态 partial）
AGENT_EXPLORE_MAX_ROUNDS=8
# 整个子智能体的墙钟上限（秒）
AGENT_EXPLORE_TIMEOUT=120
# 返回给主模型的摘要上限（字符）
AGENT_EXPLORE_MAX_REPORT_CHARS=4000
# 单个任务最多委派几次只读探索（并发度另由下面的 MAX_CONCURRENT_AGENTS 限制）
AGENT_MAX_DELEGATE_CALLS=6
# 同一条消息里的多个探索子智能体最多同时跑几个（只读，无写冲突）
AGENT_MAX_CONCURRENT_AGENTS=4
# 同一条消息里的多个只读工具最多同时跑几个（写工具始终串行）
AGENT_MAX_CONCURRENT_TOOLS=4
# 成本感知的委派预算：文件数 < MIN 不委派；[MIN,MEDIUM) 最多 MEDIUM_CALLS；
# [MEDIUM,LARGE) 最多 LARGE_CALLS；>= LARGE 用 AGENT_MAX_DELEGATE_CALLS。
AGENT_DELEGATE_MIN_FILES=30
AGENT_DELEGATE_MEDIUM_FILES=100
AGENT_DELEGATE_LARGE_FILES=300
AGENT_DELEGATE_MEDIUM_CALLS=2
AGENT_DELEGATE_LARGE_CALLS=4

# ---------- Orchestrator（Phase 3A）----------
# 新架构默认启用：满足规模阈值的仓库走 harness 路径；小仓库仍由 runtime
# 选择 direct 快速路径。设为 false 可完全回退单 agent。
AGENT_ORCHESTRATOR_ENABLED=true
# 小于该文件数不做编排，直接单 agent。
AGENT_ORCHESTRATOR_MIN_FILES=30
# 规模阈值之上再做一次请求级快速判定：明显的单文件/只读问答/小修改走 direct。
AGENT_ORCHESTRATOR_SMART_ENTRY=true
# survey 跳过 repo_map，等确认要编排后由 plan_tasks 构建（大仓库省一次全量扫描）。
AGENT_ORCHESTRATOR_REPO_MAP_LAZY=false
# 任务图校验失败时先带错误反馈让模型修一次，仍失败才整图降级。
AGENT_ORCHESTRATOR_PLAN_REPAIR=true
AGENT_ORCHESTRATOR_MAX_TASKS=6
# 只读并行收益比阈值（任务数 / 关键路径）；低于该值时回退 direct。0 = 关闭预估。
AGENT_ORCHESTRATOR_MIN_PARALLEL_GAIN=1.2
# 同时最多运行几个 worker。
AGENT_ORCHESTRATOR_MAX_CONCURRENT_WORKERS=4
# 单个任务失败后最多重试几次（0 = 不重试）。
AGENT_ORCHESTRATOR_TASK_RETRIES=1
# Phase 3C：并发写 worker（默认关闭）。还要求 --write、git 仓库且干净。
AGENT_ORCHESTRATOR_WRITE_ENABLED=false
AGENT_ORCHESTRATOR_WORKER_ROUNDS=12
AGENT_ORCHESTRATOR_WORKER_REPAIRS=2
AGENT_ORCHESTRATOR_WORKER_TIMEOUT=240
# worker 外层兜底超时（秒，0 = 自动推导），防止 runner 内部超时漏配时卡到 run deadline。
AGENT_ORCHESTRATOR_WORKER_HARD_TIMEOUT_S=0
# 交给主 agent 的 worker 汇总上限（字符）。
AGENT_ORCHESTRATOR_CONTEXT_CHARS=8000

# ---------- 统一 harness ----------
# 写 worker 的 write_scope 在 I/O 前强制校验
AGENT_ORCHESTRATOR_WRITE_SCOPE_ENFORCE=true
# 允许 implement 改同一文件，用 3-way 合并；冲突时整批回滚
AGENT_ORCHESTRATOR_ALLOW_OVERLAP=false
# fan-in 落 artifact store 并输出结构化结果
AGENT_ORCHESTRATOR_FANOUT_ARTIFACTS=true
# 整个编排阶段墙钟上限（秒，0 = 不限制）
AGENT_ORCHESTRATOR_RUN_DEADLINE_S=900
# 429/限流时的首次退避秒数（之后指数增长，上限 30s）
AGENT_ORCHESTRATOR_RATE_LIMIT_BACKOFF_S=2.0
# 单任务 token 上限（0 = 不限制）
AGENT_ORCHESTRATOR_TASK_TOKENS=0
# 整个编排阶段的 token 上限（0 = 不限制）；派发前按角色预留。
# 耗尽时停派发、取消只读在飞；implement 继续跑完并合并。
AGENT_ORCHESTRATOR_TOTAL_TOKENS=500000
# 在飞 implement + 待合并补丁的上限；超过后暂停启动新的 implement。
AGENT_ORCHESTRATOR_MAX_PENDING_MERGES=8
# 无文件交集的已完成补丁立即按连通分量合并（默认开启；出问题可设 false 回退）。
AGENT_ORCHESTRATOR_INCREMENTAL_MERGE=true
# 合并前只对高风险 patch（测试/配置/CI/安全路径或大 diff）调用一次 review 模型。
AGENT_ORCHESTRATOR_PATCH_REVIEW=true
AGENT_ORCHESTRATOR_PATCH_REVIEW_MAX_LINES=400
AGENT_ORCHESTRATOR_PATCH_REVIEW_MAX_CHARS=60000
# 同时进行的补丁审查数（LLM 调用）；并发化可缩短合并尾部延迟。
AGENT_ORCHESTRATOR_PATCH_REVIEW_CONCURRENCY=2
# 顺序写波次：后一波 implement 基于前一波已合并结果继续修改（默认关闭）。
AGENT_ORCHESTRATOR_SEQUENTIAL_WRITES=false
# verify 失败后重入 orchestrator 修复的最大轮数（0 = 关闭）。
AGENT_ORCHESTRATOR_FIX_ROUNDS=0
# 灰度期最多写波次数 / 基线注入上限
AGENT_ORCHESTRATOR_MAX_WRITE_STAGES=2
AGENT_ORCHESTRATOR_SEED_MAX_FILES=200
AGENT_ORCHESTRATOR_SEED_MAX_BYTES=5000000
# scheduler 每完成多少个任务返回一次父图（checkpoint/干预边界）
AGENT_ORCHESTRATOR_CHECKPOINT_EVERY=4
# worker 结果 journal：崩溃/resume 时复用已完成的只读结果，避免重跑。
# implement 永不复用；默认只在干净 git 仓库（HEAD 相同）时启用。
AGENT_WORKER_JOURNAL_ENABLED=true
AGENT_WORKER_JOURNAL_ROLES=explore,review
AGENT_WORKER_JOURNAL_REUSE_PARTIAL=false
AGENT_WORKER_JOURNAL_REQUIRE_CLEAN_GIT=true
AGENT_WORKER_JOURNAL_MAX_BYTES=10485760
# ---------- 深层工作流（RFC-0009/ADR-0029/0030，默认关闭）----------
AGENT_DEEP_WORKFLOWS_ENABLED=false
AGENT_KNOWLEDGE_ARTIFACTS_ENABLED=false
# 知识检索：lexical（默认零依赖）| vector | hybrid。
AGENT_KNOWLEDGE_SEARCH_MODE=lexical
# 空 = 继承 MEMORY_EMBEDDING_PROVIDER；remote 仍受 MEMORY_ALLOW_REMOTE_EMBEDDINGS 门禁。
AGENT_KNOWLEDGE_EMBEDDING_PROVIDER=
AGENT_KNOWLEDGE_EMBEDDING_DIM=0
# ---------- 资料库（每用户跨工作区，Phase 1）----------
# 默认关闭；开启后只暴露只读 library_search 工具。
AGENT_LIBRARY_ENABLED=false
# WSL 内资料库根；空 = $HOME/.agent-library。Web 多用户自动按用户隔离。
AGENT_LIBRARY_ROOT=
AGENT_LIBRARY_MAX_ITEMS=100
AGENT_LIBRARY_MAX_ITEM_BYTES=20971520
AGENT_LIBRARY_MAX_TOTAL_BYTES=268435456
AGENT_LIBRARY_CHUNK_CHARS=4000
AGENT_LIBRARY_CHUNK_OVERLAP=200
AGENT_LIBRARY_SEARCH_TOP_K=8
AGENT_LIBRARY_SEARCH_MAX_CHARS=8000
# MMR 多样性权重：1 = 纯相关度，越小越去重。
AGENT_LIBRARY_MMR_LAMBDA=0.7
# 确定性 rerank：查询短语/标题命中加权。
AGENT_LIBRARY_RERANK_ENABLED=true
AGENT_LIBRARY_RERANK_BOOST=0.25
# linear（默认）| hnswlib；未安装/失败自动回退 linear。
AGENT_LIBRARY_VECTOR_BACKEND=linear
AGENT_LIBRARY_VECTOR_CANDIDATES=50
# lexical（默认，零依赖）| vector | hybrid；失败自动回退词法。
AGENT_LIBRARY_SEARCH_MODE=lexical
# 空 = 继承 MEMORY_EMBEDDING_PROVIDER；remote 仍受 MEMORY_ALLOW_REMOTE_EMBEDDINGS 门禁。
AGENT_LIBRARY_EMBEDDING_PROVIDER=
# 0 = 继承 MEMORY_EMBEDDING_DIM。
AGENT_LIBRARY_EMBEDDING_DIM=0
# 异步摄取/重建任务并发上限；崩溃后超过 stale 秒数的任务标记失败。
AGENT_LIBRARY_MAX_CONCURRENT_JOBS=2
AGENT_LIBRARY_JOB_STALE_S=3600
# 长文档：取消固定 3 次读取；未读完时报告 partial + 未读区间。
AGENT_DOCUMENT_FULL_COVERAGE=false
# 长文档：按 chunk 分批抽取并合并。
AGENT_DOCUMENT_MAP_REDUCE=false
AGENT_DOCUMENT_CHUNK_CHARS=6000
AGENT_DOCUMENT_MAP_CONCURRENCY=3
# 每篇文档的固定槽位证据矩阵（问题/方法/算法/实验/局限/创新/结论）。
# 默认关闭：每篇会多一次结构化调用；长文档/报告场景可显式开启。
AGENT_DOCUMENT_MATRIX_ENABLED=false
# 分层归并：每层节点数上限与单次归并输入字符上限。
AGENT_DOCUMENT_TREE_FANOUT=5
AGENT_DOCUMENT_TREE_INPUT_CHARS=16000
# author 证据上下文（claim + quote + anchor）。
AGENT_AUTHOR_EVIDENCE_TOP_K=12
AGENT_AUTHOR_EVIDENCE_MAX_CHARS=24000
# 代码架构：ArchIndex/ArchBrief/影响分析注入规划提示。
AGENT_ARCH_WORKFLOW_ENABLED=false
AGENT_ARCH_IMPACT_MAX_MODULES=40
# 架构索引：多语言/大规模抽样与增量缓存。
AGENT_ARCH_MAX_FILES=2000
AGENT_ARCH_MAX_FILE_BYTES=1000000
AGENT_ARCH_MAX_TOTAL_BYTES=32000000
AGENT_ARCH_INCREMENTAL_INDEX=true
# 空 = 宿主 ~/.codingagent/index-cache；指向共享盘可跨机器复用（内容寻址）。
AGENT_ARCH_INDEX_CACHE_DIR=
AGENT_ARCH_INDEX_CACHE_MAX_ENTRIES=20000
AGENT_ARCH_INDEX_CACHE_MAX_BYTES=536870912
AGENT_ARCH_INDEX_CACHE_TTL_DAYS=30
AGENT_ARCH_INDEX_CACHE_LOCK_TIMEOUT_S=5
AGENT_ARCH_INDEX_CACHE_LOCK_STALE_S=60
# 可选：用 LSP definition 解析动态调用（需要 AGENT_LSP_COMMAND）。
AGENT_ARCH_LSP_RESOLUTION_ENABLED=false
AGENT_ARCH_LSP_MAX_CALLS=50
# 文档 judge 通过阈值；可用 scripts/calibrate_judge.py 在标注集上调。
AGENT_DOCUMENT_JUDGE_PASS_SCORE=60
# 跨模块变更：按 ChangeContract 自动分波，并在波次之间跑受影响测试 gate。
AGENT_INTERFACE_FIRST_WRITES=false
AGENT_DEEP_MAX_WRITE_STAGES=4
# worker 专用模型（空 = 继承 DEEPSEEK_MODEL）
AGENT_ORCHESTRATOR_WORKER_MODEL=
# 工作流选择/任务图生成专用模型（空 = 继承主模型）
AGENT_ORCHESTRATOR_PLANNER_MODEL=
# 角色级模型覆盖（空 = 沿用 WORKER_MODEL，再退到主模型）。
# explore/review 默认用便宜模型，失败重试时自动升级到主模型；
# 网关不支持 deepseek-flash 时，把这两个变量置空即可回退。
AGENT_ORCHESTRATOR_EXPLORE_MODEL=deepseek-flash
AGENT_ORCHESTRATOR_REVIEW_MODEL=deepseek-flash
AGENT_ORCHESTRATOR_IMPLEMENT_MODEL=
AGENT_ORCHESTRATOR_DOCUMENT_MODEL=
AGENT_ORCHESTRATOR_AUTHOR_MODEL=
# fan-in 超预算/有冲突时才调用一次 reducer LLM
AGENT_ORCHESTRATOR_FANIN_REDUCER=false
# 只读模式下只有一个任务时，是否强行补一个「找测试」explore（默认关闭以省成本）
AGENT_ORCHESTRATOR_ADD_EXPLORE_TESTS=false
# 派发 implement 前一次性确认 write_scope（并发区不弹审批）
AGENT_ORCHESTRATOR_WRITE_PLAN_APPROVAL=false

# ---------- 空步骤重做 ----------
# verify 与 review 都只在「本步改过东西」时执行，于是「只读了文件」与
# 「做完了」在图上无法区分 —— 模型会把整个计划"读"完就算完成。
# 打开后：一步没产生任何改动就打回重做一次（上限一次，且允许"这一步确实只读"）。
AGENT_NUDGE_EMPTY_STEPS=true

# ---------- 持久化与审计 ----------
# 留空 = <当前目录>/.agent/checkpoints.sqlite；填 :memory: 强制不落盘
AGENT_CHECKPOINT_PATH=
# 每个会话/命名空间保留的 checkpoint 数；0 = 不轮转
AGENT_CHECKPOINT_KEEP=200
AGENT_AUDIT_ENABLED=true
# 同一工作区只允许一个 runtime 运行（锁文件在审计目录下）。
AGENT_WORKSPACE_LOCK=true
# 留空 = <当前目录>/.agent/audit
AGENT_AUDIT_DIR=
# 快照校验清单根目录；留空 = ~/.codingagent/snapshots（放在工作区外）
AGENT_SNAPSHOT_MANIFEST_DIR=
# 快照保留：每次运行开始清理；keep=0 或 days=0 表示不按该维度清理
AGENT_SNAPSHOT_KEEP_COUNT=200
AGENT_SNAPSHOT_KEEP_DAYS=30
# 未消费 steering 指令与 pause 标记的持久化目录；留空 = <cwd>/.agent/steering
AGENT_STEERING_DIR=
# 跨进程限流冷却状态；留空 = <cwd>/.agent/rate_limits.json；:memory: 关闭共享
AGENT_RATE_LIMIT_STATE_PATH=
# 单个审计文件超过该大小（MB）就轮转（<date>.1.jsonl…）；0 = 不轮转
AGENT_AUDIT_MAX_MB=256
# SIEM：host:port（UDP syslog），每条审计 JSON 一行；空 = 不导出
AGENT_AUDIT_SYSLOG_ADDRESS=
# SIEM webhook：POST 每条审计 JSON；Bearer token 可选
AGENT_AUDIT_WEBHOOK_URL=
AGENT_AUDIT_WEBHOOK_TOKEN=

# ---------- Agent 循环 ----------
AGENT_MAX_REPAIR_ROUNDS=3
# 连续同一失败签名达到该次数后，不再 repair，改走 replan（0 = 关闭该闸）
AGENT_MAX_SAME_FAILURES=2
# 执行中「重建剩余计划」的次数上限（0 = 不重规划）
AGENT_MAX_REPLANS=2
AGENT_MAX_TOOL_ROUNDS=12
AGENT_MAX_PLAN_STEPS=5
# 同一会话「挂起→恢复」总次数上限，防前端反复 resume 绕开 recursion_limit
AGENT_MAX_RESUMES=50
# 一次完整运行（含 resume）的总墙钟上限（秒）；0 = 不限制。
AGENT_RUN_DEADLINE_S=1800
AGENT_LLM_TEMPERATURE=0.0
AGENT_LLM_TIMEOUT=120

# ---------- 审批 ----------
AGENT_MAX_FILE_READ_BYTES=2000000
# 文档解析（宿主进程，不进入 WSL）；旧 .doc/.ppt 不转换，需先另存为 docx/pptx。
AGENT_DOCUMENT_PIPELINE_ENABLED=true
AGENT_DOCUMENT_CACHE=true
AGENT_DOCUMENT_CACHE_MAX_BYTES=536870912
AGENT_DOCUMENT_CACHE_TTL_DAYS=30
AGENT_ORCHESTRATOR_DOCUMENT_CONCURRENCY=2
AGENT_ORCHESTRATOR_VISION_CONCURRENCY=2
AGENT_ORCHESTRATOR_AUTHOR_CONCURRENCY=1
AGENT_DOCUMENT_PIPELINE_MAX_DOCS=10
AGENT_DOCUMENT_PIPELINE_MAX_IMAGES=20
AGENT_ORCHESTRATOR_DOCUMENT_CHECKPOINT=true
AGENT_DOCUMENT_READ_PAGES_PER_CALL=5
AGENT_DOCUMENT_READ_MAX_CALLS=3
AGENT_DOCUMENT_EDIT_MAX_OPS=50
AGENT_ORCHESTRATOR_DEPENDENCY_CONTEXT_CHARS=12000
# 默认只处理文本型 PDF；扫描页需显式开启 OCR/视觉链路。
AGENT_PDF_TEXT_ONLY=true
AGENT_DOCUMENT_OCR_ENABLED=false
AGENT_PDF_EXTRACT_METADATA=true
AGENT_PDF_EXTRACT_OUTLINE=true
AGENT_PDF_EXTRACT_ANNOTATIONS=true
AGENT_PDF_EXTRACT_FORMS=true
AGENT_PDF_EXTRACT_ATTACHMENTS=true
AGENT_PDF_EXTRACT_TABLES=true
AGENT_DOCUMENT_OCR_MAX_PAGES=5
AGENT_DOCUMENT_IMAGE_MAX_ITEMS=5
# 角色级累计 token 硬预算；0 = 不限制。文档/报告是单次成本最高的角色。
AGENT_ORCHESTRATOR_DOCUMENT_TOKEN_BUDGET=120000
AGENT_ORCHESTRATOR_VISION_TOKEN_BUDGET=60000
AGENT_ORCHESTRATOR_AUTHOR_TOKEN_BUDGET=60000
AGENT_DOCUMENT_MAX_BYTES=20971520
AGENT_DOCUMENT_MAX_PAGES=200
AGENT_DOCUMENT_MAX_CELLS=20000
AGENT_DOCUMENT_MAX_CHARS=2000000
# 图片理解：默认 LLM 视为多模态模型；端点不支持时明确报错。
AGENT_IMAGE_MAX_BYTES=10485760
AGENT_IMAGE_MAX_DIMENSION=2048
# 报告导出：PDF 运行期查找系统 CJK 字体，不附带字体文件。
AGENT_REPORT_OUTPUT_DIR=.agent/artifacts/reports
AGENT_REPORT_FONT_PATH=
AGENT_REPORT_ALLOW_ANY_PATH=false
AGENT_REPORT_LLM_REVIEW=false
# ask（逐条询问）| approve（自动放行 L2；L3 仍需确认）| deny（一律拒绝）
AGENT_APPROVAL_MODE=ask

# ---------- 安全 profile / 不可信仓库 ----------
# local（可信仓库）| untrusted（bwrap + 禁网 + 强制 ask + 不信任仓库指令/记忆）
# production / ops（bwrap + 禁网 + deny + 强制只读，适合生产只读排查）
# 注意：agent web 默认使用 untrusted
AGENT_SECURITY_PROFILE=local
AGENT_TRUST_REPO_INSTRUCTIONS=true
AGENT_TRUST_REPO_MEMORY=true
# 记忆根目录（WSL 绝对路径）；空则按 trust_repo_memory 推导
# 不可信仓库下默认按工作区哈希隔离到 $HOME/.agent-memory/<hash>/
AGENT_MEMORY_ROOT=
# 跨工作区全局记忆根；空 = $HOME/.agent-memory/global
AGENT_MEMORY_GLOBAL_ROOT=
# ---------- 可选向量检索（默认关闭，失败自动回退 BM25）----------
# 需要本地模型：pip install -e ".[embeddings]"
AGENT_MEMORY_VECTOR_ENABLED=false
# local（fastembed）| hash（确定性测试向量）| none
AGENT_MEMORY_EMBEDDING_PROVIDER=local
AGENT_MEMORY_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
AGENT_MEMORY_EMBEDDING_DIM=512
# 模型缓存目录；空 = fastembed 默认缓存在宿主 $HOME/.cache
AGENT_MEMORY_EMBEDDING_CACHE_DIR=
AGENT_MEMORY_VECTOR_TOP_N=20
AGENT_MEMORY_FUSION=rrf
# ---------- 远程 embedding（默认关闭；会离开本机，需双重显式开启）----------
# 仅 local profile 可用；untrusted / production / ops 一律拒绝
AGENT_MEMORY_ALLOW_REMOTE_EMBEDDINGS=false
AGENT_MEMORY_EMBEDDING_BASE_URL=
AGENT_MEMORY_EMBEDDING_API_KEY=
AGENT_MEMORY_EMBEDDING_TIMEOUT_S=10
AGENT_MEMORY_EMBEDDING_BATCH_SIZE=64
# 秘密文件读保护（逗号分隔）；.env.example/.sample/.template 自动放行
AGENT_READ_DENY_GLOBS=.env,.env.*,*.pem,*.key,*.p12,*.pfx,id_rsa*,id_ed25519*,id_ecdsa*,.ssh/**,.netrc,.npmrc,.pypirc,.git-credentials,credentials,**/credentials,credentials.json,**/credentials.json,*service-account*.json,*service_account*.json,.aws/**,**/.aws/**,.kube/**,**/.kube/**,.config/gcloud/**,**/.config/gcloud/**,.docker/config.json,**/.docker/config.json,*.tfstate,*.tfstate.backup,*.jks,*.keystore,*.gpg

# ---------- Web 多用户 / 公网 ----------
# JSON：{"token": "user"}；支持 sha256:<hex>。与 FILE 二选一（FILE 优先合并）
AGENT_WEB_AUTH_TOKENS=
AGENT_WEB_AUTH_TOKENS_FILE=
# 企业账号：开启后使用 /admin 登录与 Session Cookie；需控制面数据库
AGENT_WEB_ACCOUNTS_ENABLED=false
AGENT_WEB_ACCOUNT_TENANT=default
# 企业账号生产约束：只允许 MySQL；SQLite 仅限本地测试时设 false
AGENT_WEB_ACCOUNTS_REQUIRE_MYSQL=true
# 跨源部署（静态站与 API 不同源）时必须 true，Cookie 才会 Secure+SameSite=None
# 非 loopback + 账号 Cookie 登录时必须为 true，否则进程拒绝启动
AGENT_WEB_COOKIE_SECURE=false
AGENT_WEB_SESSION_TTL_S=43200
# 空闲超时（秒）；0 = 关闭，只使用上面的绝对 TTL
AGENT_WEB_SESSION_IDLE_TTL_S=0
# 自助密码重置：对外根与邮件投递（host 为空 = 只生成 token 不发送）
AGENT_WEB_PUBLIC_URL=
AGENT_WEB_PASSWORD_RESET_TTL_S=1800
AGENT_SMTP_HOST=
AGENT_SMTP_PORT=587
AGENT_SMTP_USER=
AGENT_SMTP_PASSWORD=
AGENT_SMTP_FROM=
AGENT_SMTP_STARTTLS=true

# ---------- 企业身份：OIDC / MFA / 四眼审批（RFC-0004） ----------
# 默认关闭；开启 OIDC/MFA/四眼都要求企业账号 + 控制面数据库。
AGENT_OIDC_ENABLED=false
AGENT_OIDC_ISSUER=
AGENT_OIDC_CLIENT_ID=
AGENT_OIDC_CLIENT_SECRET=
AGENT_OIDC_REDIRECT_URI=
AGENT_OIDC_SCOPES=openid profile email
AGENT_OIDC_AUTO_CREATE_USERS=true
AGENT_OIDC_DEFAULT_ROLE=member
# 允许的 IdP group claim，以及 JSON 映射 {"group":"admin"}
AGENT_OIDC_ROLE_CLAIM=groups
AGENT_OIDC_ROLE_MAP=
AGENT_OIDC_USERNAME_CLAIM=preferred_username
AGENT_OIDC_EMAIL_CLAIM=email
AGENT_OIDC_STATE_TTL_S=600
AGENT_OIDC_HTTP_TIMEOUT_S=10
# 仅本地开发允许 http:// issuer；生产必须 HTTPS
AGENT_OIDC_ALLOW_INSECURE_HTTP=false
# 本地账号 TOTP；OIDC 登录的 MFA 由 IdP 负责
AGENT_MFA_ENABLED=false
AGENT_MFA_ISSUER=CodingAgent
AGENT_MFA_CHALLENGE_TTL_S=300
AGENT_MFA_MAX_ATTEMPTS=5
AGENT_MFA_WINDOW_STEPS=1
# 四眼审批：L3 决定必须由非发起人的 owner/admin 写入
AGENT_APPROVAL_FOUR_EYES=false
AGENT_APPROVAL_FOUR_EYES_MIN_LEVEL=3
AGENT_APPROVAL_TTL_S=3600

# 浏览器 Web Push（VAPID）；公/私钥都配置且安装 pywebpush 才启用
# pip install -e ".[webpush]"
AGENT_WEBPUSH_PUBLIC_KEY=
AGENT_WEBPUSH_PRIVATE_KEY=
AGENT_WEBPUSH_SUBJECT=mailto:admin@localhost
AGENT_WEBPUSH_TTL=3600

# 运行前 token 预留；0 = 只做事后限额
AGENT_WEB_QUOTA_RESERVE_TOKENS=20000
# 成本展示与额度货币；上游价格仍按 USD 记账
AGENT_COST_CURRENCY=CNY
AGENT_USD_TO_CNY=7.2
# 登录按来源 IP 限流（次/分钟）
AGENT_WEB_LOGIN_RATE_LIMIT_PER_MIN=10
# 匿名 CSP 违规上报按来源 IP 限流（防止日志放大）
AGENT_WEB_CSP_REPORT_RATE_LIMIT_PER_MIN=300
# memory = 单进程内存；redis = 多实例共享（需 URL，缺省复用事件传输 URL）
AGENT_RATE_LIMIT_BACKEND=memory
AGENT_RATE_LIMIT_REDIS_URL=
# A2 /metrics 的抓取 token；空 = 复用普通 Web 认证
AGENT_METRICS_TOKEN=
# text | json；容器/日志采集建议 json
AGENT_LOG_FORMAT=text
# /openapi.json 与 /docs；默认关闭，避免暴露完整路由表
AGENT_WEB_OPENAPI=false
# OTLP HTTP trace；空 = 关闭；需 pip install -e ".[otel]"
AGENT_OTEL_ENDPOINT=
AGENT_OTEL_SERVICE_NAME=coding-agent
AGENT_OTEL_HEADERS=
# SIGTERM 优雅退出：A3 等待进行中运行结束，超时后取消；A2 同值约束在途请求
AGENT_DRAIN_TIMEOUT_S=60
# 配额预留存活时间；进程崩溃后由其他实例/下次启动清理
AGENT_QUOTA_RESERVATION_TTL_S=3600
# 上游 provider Key 的 AES-256-GCM 主密钥：base64 或 64 位 hex（32 字节）
AGENT_SECRET_MASTER_KEY=
AGENT_SECRET_MASTER_KEY_FILE=
# 主密钥代次；仅记录/审计，轮换脚本会更新密文的 key_version
AGENT_SECRET_MASTER_KEY_VERSION=1
# per-user 工作区根（WSL）；空 = $HOME/agent-ws/users
AGENT_WEB_WORKSPACES_ROOT=
# per-user 宿主数据根（审计/checkpoint/steering）；空 = ./.agent/web/users
AGENT_WEB_DATA_ROOT=
# per-user WSL 记忆根；空 = $HOME/agent-memory
AGENT_WEB_MEMORY_ROOT=
# per-user WSL 资料库根；空 = $HOME/agent-library
AGENT_WEB_LIBRARY_ROOT=
AGENT_WEB_MAX_BODY_BYTES=262144
AGENT_WEB_MAX_PROMPT_CHARS=100000
# GUI/Web 上传：单文件与单次文件数上限；写入工作区 .agent/uploads
AGENT_WEB_MAX_UPLOAD_BYTES=20971520
AGENT_WEB_MAX_UPLOAD_FILES=20
AGENT_WEB_MAX_UPLOAD_TOTAL_BYTES=209715200
AGENT_WEB_RATE_LIMIT_PER_MIN=60
AGENT_WEB_MAX_RUNTIMES=8
AGENT_WEB_MAX_RUNTIMES_PER_USER=2
AGENT_WEB_RUNTIME_TTL_S=1800
AGENT_WEB_ALLOW_ANONYMOUS_LOCAL=true
# 是否由 A2 托管前端页面；独立静态站/CDN 部署时设 false（桌面强制开启）
AGENT_WEB_SERVE_FRONTEND=true
# 前端发布包根目录；空 = 包内 web/static
AGENT_WEB_FRONTEND_DIR=
# /static 挂载目录；空 = 自动识别（发布包用 <frontend_dir>/static）
AGENT_WEB_STATIC_DIR=

# ---------- A2 控制面（Phase B） ----------
# 空 = 继续用 gui-sessions.json / 本地文件；示例：
# mysql+pymysql://coding_agent:pass@127.0.0.1:3306/coding_agent?charset=utf8mb4
AGENT_CONTROL_DB_URL=
# 仅开发/首次启动自动建表；生产请用迁移脚本关闭
AGENT_CONTROL_DB_AUTO_CREATE=true
# auto | keyring | systemd
AGENT_SECRET_PROVIDER=auto
# 共享事件传输：memory（单实例）/ redis（多实例 SSE 重放）
AGENT_EVENT_TRANSPORT=memory
AGENT_EVENT_TRANSPORT_URL=
AGENT_EVENT_TRANSPORT_PREFIX=coding-agent:events
AGENT_EVENT_TRANSPORT_MAXLEN=10000
AGENT_EVENT_TRANSPORT_TTL_S=3600

# ---------- A2 → A3 内部连接（Phase B4） ----------
# 空 = 同进程（默认）；设置后运行生命周期走独立 Agent Server
AGENT_INTERNAL_URL=
AGENT_INTERNAL_TOKEN=
# Agent Server 的租户数据根；空 = 审计目录旁的 agent/
AGENT_AGENT_DATA_ROOT=

# ---------- A2L 宿主能力代理（默认关闭） ----------
AGENT_HOST_BROKER_ENABLED=false
AGENT_HOST_BROKER_URL=
AGENT_HOST_A2L_ID=a2l-local
# A2L 设备证书/私钥（客户端身份）；企业/非 loopback 必须启用 TLS
AGENT_HOST_BROKER_DEVICE_CERT=
AGENT_HOST_BROKER_DEVICE_KEY=
# 服务端证书/私钥 + 双向校验 CA
AGENT_HOST_BROKER_TLS_CERT=
AGENT_HOST_BROKER_TLS_KEY=
AGENT_HOST_BROKER_TLS_CA=
AGENT_HOST_BROKER_TLS_SERVER_NAME=
AGENT_HOST_BROKER_REQUIRE_TLS=false
# P1/P2：host 写与受控 exec 默认关闭；开启后仍逐次 grant
AGENT_HOST_BROKER_ALLOW_WRITE=false
AGENT_HOST_BROKER_EXEC_ENABLED=false
# JSON 数组；每项 {id,kind,root,commands,output_roots}；root 只留在 A2L
AGENT_HOST_BROKER_TOOLCHAINS=
# 宿主快照目录；空 = %LOCALAPPDATA%\CodingAgent\host-snapshots
AGENT_HOST_SNAPSHOT_DIR=
# 设备台账（A3 本地 JSON）与接入策略：off（默认）/ enforce
AGENT_HOST_BROKER_DEVICE_REGISTRY=
AGENT_HOST_BROKER_DEVICE_POLICY=off
AGENT_HOST_BROKER_DEVICE_RELOAD_S=2
# A2L 签名策略：文件 + 固定 Ed25519 公钥（raw/base64/hex 或 PEM）
AGENT_HOST_BROKER_POLICY_FILE=
AGENT_HOST_BROKER_POLICY_PUBKEY=
AGENT_HOST_BROKER_POLICY_PUBKEY_FILE=
# 设备证明：off / auto / require / tpm
AGENT_HOST_BROKER_ATTESTATION=off
AGENT_HOST_BROKER_ATTESTATION_KEY=
